{
  "name": "has-a-computer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "www:dev": "pnpm -F @has-a-computer/www dev",
    "worker:dev": "pnpm -F @has-a-computer/worker dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "audit": "pnpm audit --audit-level high",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
