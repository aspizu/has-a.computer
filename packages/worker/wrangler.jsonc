{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "has-a-computer-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "simple": {
          "limit": 60,
          "period": 60,
        },
      },
    ],
  },
}
